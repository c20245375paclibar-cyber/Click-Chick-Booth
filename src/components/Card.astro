---
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  desc: string;
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageFit?: "cover" | "contain";
  interactiveImage?: boolean;
  icon?: "chat" | "image" | "layout" | "code" | "sparkles" | "database";
}

const {
  title,
  desc,
  eyebrow,
  image,
  imageAlt = "",
  imageFit = "cover",
  interactiveImage = false,
  icon,
} = Astro.props;
---

<article class:list={["content-card", interactiveImage && "content-card-project"]}>
  {image && (
    interactiveImage ? (
      <div class="content-card-media">
        <img
          class:list={[
            "content-card-image",
            imageFit === "contain" && "content-card-image-contain",
          ]}
          src={image.src}
          width={image.width}
          height={image.height}
          alt={imageAlt}
          loading="lazy"
        />
        <span class="content-card-image-overlay" aria-hidden="true"></span>
      </div>
    ) : (
      <img
        class:list={[
          "content-card-image",
          imageFit === "contain" && "content-card-image-contain",
        ]}
        src={image.src}
        width={image.width}
        height={image.height}
        alt={imageAlt}
        loading="lazy"
      />
    )
  )}
  {icon && (
    <span class="content-card-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        {icon === "chat" && (
          <>
            <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z" />
          </>
        )}
        {icon === "image" && (
          <>
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </>
        )}
        {icon === "layout" && (
          <>
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <path d="M3 9h18M9 21V9" />
          </>
        )}
        {icon === "code" && (
          <>
            <path d="m8 17-5-5 5-5M16 7l5 5-5 5M14 4l-4 16" />
          </>
        )}
        {icon === "sparkles" && (
          <>
            <path d="m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3Z" />
            <path d="m19 14 1 2.5 2.5 1-2.5 1L19 21l-1-2.5-2.5-1 2.5-1L19 14Z" />
          </>
        )}
        {icon === "database" && (
          <>
            <ellipse cx="12" cy="5" rx="8" ry="3" />
            <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
          </>
        )}
      </svg>
    </span>
  )}
  {eyebrow && <span class="content-card-eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  <p>{desc}</p>
</article>

<style>
  .content-card {
    background: #fffdf7;
    border: 1px solid #d8ccb8;
    border-radius: 16px;
    box-shadow: 0 10px 28px rgba(58, 48, 40, 0.055);
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 210px;
    padding: 32px 30px;
    position: relative;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .content-card::before {
    background: #c5a77f;
    border-radius: 999px;
    content: "";
    height: 3px;
    left: 30px;
    position: absolute;
    top: 0;
    transition: width 220ms ease;
    width: 34px;
  }

  .content-card:hover {
    border-color: #c5a77f;
    box-shadow: 0 18px 38px rgba(58, 48, 40, 0.1);
    transform: translateY(-4px);
  }

  .content-card:hover::before {
    width: 58px;
  }

  .content-card-image {
    border-radius: 7px;
    display: block;
    height: 190px;
    margin: -12px -10px 10px;
    object-fit: cover;
    width: calc(100% + 20px);
  }

  .content-card-image-contain {
    object-fit: contain;
  }

  .content-card-project {
    overflow: hidden;
  }

  .content-card-media {
    background: #f5f0e6;
    border-radius: 7px;
    height: 190px;
    margin: -12px -10px 10px;
    overflow: hidden;
    position: relative;
    width: calc(100% + 20px);
  }

  .content-card-media .content-card-image {
    border-radius: 0;
    height: 100%;
    margin: 0;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
  }

  .content-card-image-overlay {
    background: rgba(36, 31, 26, 0.22);
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transition: opacity 240ms ease;
  }

  .content-card.content-card-project:hover,
  .content-card.content-card-project:focus-within {
    box-shadow: 0 18px 36px rgba(58, 48, 40, 0.12);
    transform: translateY(-5px);
  }

  .content-card-project:hover .content-card-image,
  .content-card-project:focus-within .content-card-image {
    transform: scale(1.07);
  }

  .content-card-project:hover .content-card-image-overlay,
  .content-card-project:focus-within .content-card-image-overlay {
    opacity: 1;
  }

  .content-card-eyebrow {
    background: #f1e6ce;
    border-radius: 999px;
    color: #8d6a45;
    display: inline-flex;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-bottom: 12px;
    padding: 7px 10px;
    width: fit-content;
  }

  .content-card-icon {
    align-items: center;
    background: #f1e6ce;
    border: 1px solid rgba(197, 167, 127, 0.35);
    border-radius: 14px;
    color: #8d6a45;
    display: inline-flex;
    height: 46px;
    justify-content: center;
    margin-bottom: 8px;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
    width: 46px;
  }

  .content-card-icon svg {
    height: 21px;
    width: 21px;
  }

  .content-card:hover .content-card-icon {
    background: #3a3028;
    color: #fffdf7;
    transform: rotate(-5deg);
  }

  .content-card h2 {
    color: #3a3028;
    font-size: clamp(1.08rem, 1.5vw, 1.4rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
  }

  .content-card p {
    color: #756958;
    font-size: 0.88rem;
    line-height: 1.75;
    margin: 0;
  }

  :global(:root[data-theme="dark"]) .content-card {
    background: #2c261f;
    border-color: #594f43;
  }

  :global(:root[data-theme="dark"]) .content-card h2 {
    color: #f5efe4;
  }

  :global(:root[data-theme="dark"]) .content-card p {
    color: #c6baa6;
  }

  :global(:root[data-theme="dark"]) .content-card-eyebrow {
    color: #d6b585;
  }

  :global(:root[data-theme="dark"]) .content-card-eyebrow {
    background: #3a3228;
  }

  :global(:root[data-theme="dark"]) .content-card-icon {
    background: #3a3228;
    border-color: #594f43;
    color: #d3b58a;
  }

  @media (max-width: 560px) {
    .content-card {
      min-height: 180px;
      padding: 26px 24px;
    }

    .content-card-image,
    .content-card-media {
      height: 180px;
    }

    .content-card::before {
      left: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .content-card,
    .content-card-media .content-card-image,
    .content-card-image-overlay,
    .content-card-icon {
      transition: none;
    }

    .content-card.content-card-project:hover,
    .content-card.content-card-project:focus-within,
    .content-card.content-card-project:hover .content-card-image,
    .content-card.content-card-project:focus-within .content-card-image {
      transform: none;
    }

    .content-card:hover .content-card-icon {
      transform: none;
    }
  }
</style>
