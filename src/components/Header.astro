---
const links = [
  { href: "/#services", label: "Services" },
  { href: "/#process", label: "Process" },
  { href: "/#about", label: "About" },
  { href: "/#projects", label: "Projects" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Click Chick Booth landing page">
      <svg class="brand-mark" viewBox="0 0 145 145" aria-hidden="true">
        <circle cx="47" cy="73" r="36" fill="none" stroke="currentColor" stroke-width="9" />
        <rect x="101" y="9" width="34" height="33" fill="currentColor" />
        <rect x="101" y="56" width="34" height="33" fill="currentColor" />
        <rect x="101" y="103" width="34" height="33" fill="currentColor" />
      </svg>
      <span>Click Chick Booth</span>
    </a>
    <nav class="main-nav" id="main-navigation" aria-label="Main navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="email-link" href="mailto:clickchickbooth@gmail.com">
        Email us <span aria-hidden="true">↗</span>
      </a>
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
        <span class="theme-icon" aria-hidden="true">☾</span>
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-controls="main-navigation"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector(".theme-toggle");
  const icon = toggle?.querySelector(".theme-icon");
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>(".main-nav");
  const navigationLinks = document.querySelectorAll<HTMLAnchorElement>(".main-nav a");

  const savedTheme = localStorage.getItem("theme");
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

  function applyTheme(theme: "light" | "dark") {
    root.dataset.theme = theme;
    localStorage.setItem("theme", theme);

    if (toggle && icon) {
      const isDark = theme === "dark";
      toggle.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
      toggle.setAttribute("title", isDark ? "Switch to light mode" : "Switch to dark mode");
      icon.textContent = isDark ? "☀" : "☾";
    }
  }

  applyTheme(savedTheme === "dark" || (!savedTheme && prefersDark) ? "dark" : "light");

  toggle?.addEventListener("click", () => {
    applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
  });

  function closeMenu() {
    navigation?.classList.remove("is-open");
    menuToggle?.setAttribute("aria-expanded", "false");
    menuToggle?.setAttribute("aria-label", "Open navigation menu");
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") !== "true";
    menuToggle.setAttribute("aria-expanded", String(isOpen));
    menuToggle.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
    navigation?.classList.toggle("is-open", isOpen);
  });

  navigationLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  if ("IntersectionObserver" in window) {
    const observedSections = Array.from(navigationLinks)
      .map((link) => {
        const targetUrl = new URL(link.href);
        const section = document.querySelector(targetUrl.hash);
        return targetUrl.pathname === window.location.pathname && section
          ? { link, section }
          : null;
      })
      .filter((entry): entry is { link: HTMLAnchorElement; section: Element } => entry !== null);

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          navigationLinks.forEach((link) => link.removeAttribute("aria-current"));
          const currentSection = observedSections.find(({ section }) => section === entry.target);
          currentSection?.link.setAttribute("aria-current", "location");
        });
      },
      { rootMargin: "-25% 0px -65% 0px" }
    );

    observedSections.forEach(({ section }) => sectionObserver.observe(section));
  }

</script>

<style>
  .site-header {
    background: rgba(255, 253, 247, 0.92);
    border-bottom: 1px solid rgba(216, 204, 184, 0.8);
    backdrop-filter: blur(16px);
    position: sticky;
    top: 0;
    transition: background 180ms ease, border-color 180ms ease;
    z-index: 100;
  }

  .header-inner {
    align-items: center;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    margin: 0 auto;
    max-width: 1440px;
    min-height: 72px;
    padding: 16px clamp(20px, 5vw, 68px);
  }

  .brand,
  nav a,
  .email-link {
    color: #3a3028;
    font-size: 0.78rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand {
    align-items: center;
    display: inline-flex;
    gap: 9px;
    font-weight: 700;
    justify-self: start;
    transition: color 180ms ease, transform 180ms ease;
  }

  .brand:hover {
    color: #8d6a45;
    transform: translateY(-1px);
  }

  .brand img {
    display: block;
    height: 38px;
    object-fit: contain;
    width: 38px;
  }

  .brand-mark {
    color: #3a3028;
    display: block;
    flex: none;
    height: 38px;
    width: 38px;
  }

  .main-nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 34px);
    justify-content: center;
  }

  .main-nav a,
  .email-link {
    transition: color 160ms ease;
  }

  .main-nav a {
    display: inline-flex;
    padding: 8px 2px;
    position: relative;
    transition: color 160ms ease, transform 160ms ease;
  }

  .main-nav a::after {
    background: #c5a77f;
    border-radius: 999px;
    bottom: 1px;
    content: "";
    height: 2px;
    left: 0;
    position: absolute;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
    width: 100%;
  }

  .main-nav a:hover,
  .main-nav a[aria-current="location"],
  .email-link:hover {
    color: #a78d68;
  }

  .main-nav a:hover {
    transform: translateY(-1px);
  }

  .main-nav a:hover::after,
  .main-nav a[aria-current="location"]::after {
    transform: scaleX(1);
  }

  .email-link {
    justify-self: end;
  }

  .header-actions {
    align-items: center;
    display: flex;
    gap: 12px;
    justify-self: end;
  }

  .theme-toggle {
    align-items: center;
    background: transparent;
    border: 1px solid #d8ccb8;
    border-radius: 999px;
    color: #3a3028;
    cursor: pointer;
    display: inline-flex;
    height: 36px;
    justify-content: center;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
    width: 36px;
  }

  .theme-toggle:hover {
    background: #f1e6ce;
    transform: translateY(-1px);
  }

  .theme-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .email-link span {
    margin-left: 4px;
  }

  .menu-toggle {
    align-items: center;
    background: transparent;
    border: 1px solid #d8ccb8;
    border-radius: 999px;
    cursor: pointer;
    display: none;
    flex-direction: column;
    gap: 4px;
    height: 40px;
    justify-content: center;
    width: 40px;
  }

  .menu-toggle span {
    background: currentColor;
    border-radius: 999px;
    height: 2px;
    transition: transform 180ms ease, opacity 180ms ease;
    width: 16px;
  }

  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu-toggle:focus-visible,
  .theme-toggle:focus-visible {
    outline: 2px solid #a78d68;
    outline-offset: 3px;
  }

  @media (max-width: 680px) {
    .header-inner {
      column-gap: 16px;
      grid-template-columns: 1fr auto;
      row-gap: 0;
    }

    .header-actions {
      gap: 8px;
    }

    .menu-toggle {
      color: #3a3028;
      display: inline-flex;
    }

    .main-nav {
      align-items: stretch;
      background: #fffdf7;
      border-top: 1px solid transparent;
      flex-direction: column;
      gap: 2px;
      grid-column: 1 / -1;
      order: 1;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      padding: 0 4px;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        max-height 240ms ease,
        opacity 180ms ease,
        padding 240ms ease,
        transform 180ms ease,
        visibility 180ms ease;
      visibility: hidden;
    }

    .main-nav.is-open {
      border-top-color: #d8ccb8;
      max-height: 320px;
      opacity: 1;
      padding: 12px 4px 4px;
      pointer-events: auto;
      transform: translateY(0);
      visibility: visible;
    }

    .main-nav a {
      border-radius: 6px;
      padding: 12px;
    }

    .main-nav a:hover,
    .main-nav a[aria-current="location"] {
      background: #f1e6ce;
    }

    .brand,
    .email-link {
      font-size: 0.72rem;
    }
  }

  :global(:root[data-theme="dark"]) .menu-toggle {
    border-color: #594f43;
    color: #f5efe4;
  }

  :global(:root[data-theme="dark"]) .site-header {
    background: rgba(36, 31, 26, 0.92);
    border-bottom-color: rgba(89, 79, 67, 0.8);
  }

  :global(:root[data-theme="dark"]) .brand:hover,
  :global(:root[data-theme="dark"]) .main-nav a:hover,
  :global(:root[data-theme="dark"]) .main-nav a[aria-current="location"] {
    color: #d3b58a;
  }

  :global(:root[data-theme="dark"]) .main-nav a {
    color: #f5efe4;
  }

  @media (max-width: 420px) {
    .email-link {
      display: none;
    }
  }

  @media (max-width: 680px) {
    :global(:root[data-theme="dark"]) .main-nav {
      background: #241f1a;
      border-top-color: #594f43;
    }

    :global(:root[data-theme="dark"]) .main-nav a:hover,
    :global(:root[data-theme="dark"]) .main-nav a[aria-current="location"] {
      background: #3a3228;
      color: #d3b58a;
    }
  }
</style>
