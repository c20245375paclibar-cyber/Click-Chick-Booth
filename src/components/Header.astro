---
const links = [
  { href: "/#services", label: "Services" },
  { href: "/#process", label: "Process" },
  { href: "/#about", label: "About" },
  { href: "/#projects", label: "Projects" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Click Chick Booth landing page">
      <svg class="brand-mark" viewBox="0 0 145 145" aria-hidden="true">
        <circle cx="47" cy="73" r="36" fill="none" stroke="currentColor" stroke-width="9" />
        <rect x="101" y="9" width="34" height="33" fill="currentColor" />
        <rect x="101" y="56" width="34" height="33" fill="currentColor" />
        <rect x="101" y="103" width="34" height="33" fill="currentColor" />
      </svg>
      <span>Click Chick Booth</span>
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="email-link" href="mailto:clickchickbooth@gmail.com">
        Email us <span aria-hidden="true">↗</span>
      </a>
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
        <span class="theme-icon" aria-hidden="true">☾</span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector(".theme-toggle");
  const icon = toggle?.querySelector(".theme-icon");

  const savedTheme = localStorage.getItem("theme");
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

  function applyTheme(theme: "light" | "dark") {
    root.dataset.theme = theme;
    localStorage.setItem("theme", theme);

    if (toggle && icon) {
      const isDark = theme === "dark";
      toggle.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
      toggle.setAttribute("title", isDark ? "Switch to light mode" : "Switch to dark mode");
      icon.textContent = isDark ? "☀" : "☾";
    }
  }

  applyTheme(savedTheme === "dark" || (!savedTheme && prefersDark) ? "dark" : "light");

  toggle?.addEventListener("click", () => {
    applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
  });

</script>

<style>
  .site-header {
    background: #fffdf7;
    border-bottom: 1px solid #d8ccb8;
    position: sticky;
    top: 0;
    transition: background 180ms ease;
    z-index: 100;
  }

  .header-inner {
    align-items: center;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    margin: 0 auto;
    max-width: 1440px;
    min-height: 72px;
    padding: 16px clamp(20px, 5vw, 68px);
  }

  .brand,
  nav a,
  .email-link {
    color: #3a3028;
    font-size: 0.78rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand {
    align-items: center;
    display: inline-flex;
    gap: 9px;
    font-weight: 700;
    justify-self: start;
  }

  .brand img {
    display: block;
    height: 38px;
    object-fit: contain;
    width: 38px;
  }

  .brand-mark {
    color: #3a3028;
    display: block;
    flex: none;
    height: 38px;
    width: 38px;
  }

  nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 34px);
    justify-content: center;
  }

  nav a,
  .email-link {
    transition: color 160ms ease;
  }

  nav a:hover,
  .email-link:hover {
    color: #a78d68;
  }

  .email-link {
    justify-self: end;
  }

  .header-actions {
    align-items: flex-end;
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-self: end;
  }

  .theme-toggle {
    align-items: center;
    background: transparent;
    border: 1px solid #d8ccb8;
    border-radius: 999px;
    color: #3a3028;
    cursor: pointer;
    display: inline-flex;
    height: 36px;
    justify-content: center;
    width: 36px;
  }

  .theme-toggle:hover {
    background: #f1e6ce;
  }

  .theme-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .email-link span {
    margin-left: 4px;
  }

  @media (max-width: 680px) {
    .header-inner {
      column-gap: 16px;
      grid-template-columns: 1fr auto;
      row-gap: 16px;
    }

    nav {
      flex-wrap: wrap;
      grid-column: 1 / -1;
      justify-content: space-between;
      order: 1;
    }

    nav a,
    .brand,
    .email-link {
      font-size: 0.72rem;
    }
  }
</style>
