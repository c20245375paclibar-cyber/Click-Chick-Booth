---
import ipot from "./images/ipot1.jpeg";

const links = [
  { href: "/Services", label: "Services" },
  { href: "/Process", label: "Process" },
  { href: "/About", label: "About" },
  { href: "/Projects", label: "Projects" },
  { href: "/Contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <img src={ipot.src} width={ipot.width} height={ipot.height} alt="" />
      <span>Click Chick Booth</span>
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="email-link" href="mailto:clickchickbooth@gmail.com">
      Email us <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid #e8e8e8;
  }

  .header-inner {
    align-items: center;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    margin: 0 auto;
    max-width: 1440px;
    min-height: 72px;
    padding: 16px clamp(20px, 5vw, 68px);
  }

  .brand,
  nav a,
  .email-link {
    color: #222;
    font-size: 0.78rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand {
    align-items: center;
    display: inline-flex;
    gap: 9px;
    font-weight: 700;
    justify-self: start;
  }

  .brand img {
    display: block;
    height: 38px;
    object-fit: contain;
    width: 38px;
  }

  nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 34px);
    justify-content: center;
  }

  nav a,
  .email-link {
    transition: color 160ms ease;
  }

  nav a:hover,
  .email-link:hover {
    color: #888;
  }

  .email-link {
    justify-self: end;
  }

  .email-link span {
    margin-left: 4px;
  }

  @media (max-width: 680px) {
    .header-inner {
      column-gap: 16px;
      grid-template-columns: 1fr auto;
      row-gap: 16px;
    }

    nav {
      flex-wrap: wrap;
      grid-column: 1 / -1;
      justify-content: space-between;
      order: 1;
    }

    nav a,
    .brand,
    .email-link {
      font-size: 0.72rem;
    }
  }
</style>