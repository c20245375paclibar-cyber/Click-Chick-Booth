---
import elsiePortrait from "../../pages/images/elsie-portrait.png";
import raijenPortrait from "../../pages/images/raijen-portrait.png";
import elsieRaijen from "../../pages/images/elsie-raijen.png";

const previews = [
  {
    label: "Together",
    category: "Meet the team",
    title: "Elsie & Raijen",
    description: "The people behind Click Chick Booth's creative and web projects.",
    image: elsieRaijen,
    imageAlt: "Elsie and Raijen standing back to back",
    imageFit: "cover",
  },
  {
    label: "Elsie",
    category: "Meet the team",
    title: "Elsie",
    description: "One of the creative minds behind Click Chick Booth.",
    image: elsiePortrait,
    imageAlt: "Elsie wearing glasses and a brown top",
    imageFit: "cover",
  },
  {
    label: "Raijen",
    category: "Meet the team",
    title: "Raijen",
    description: "One of the creative minds behind Click Chick Booth.",
    image: raijenPortrait,
    imageAlt: "Raijen in a brown blouse",
    imageFit: "cover",
  },
];
---

<section class="hero-section page-shell" id="hero">
  <div class="hero-copy">
    <p class="eyebrow"><span class="eyebrow-mark"></span> Creative editing & web development</p>
    <h1>Design your ideas.<br /><em>Build your experience.</em></h1>
    <p class="hero-lede">
      Click Chick Booth combines photo editing and visual layouts with programming skills to create polished, interactive digital projects.
    </p>
    <div class="hero-actions">
      <a class="button" href="/#services">Explore services <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/#process">See our process <span aria-hidden="true">→</span></a>
      <button class="hero-replay" data-replay-intro type="button" aria-label="Replay hero introduction">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4.2 7.2A6.2 6.2 0 1 1 4 10" />
          <path d="M4.1 3.8v3.8h3.8" />
        </svg>
        <span>Replay intro</span>
      </button>
    </div>
  </div>
  <div class="hero-visual">
    <div class="hero-code" aria-label="Interactive project preview">
      <div class="showcase-image-wrap">
        <img
          class="showcase-image"
          data-showcase-image
          src={previews[0].image.src}
          width={previews[0].image.width}
          height={previews[0].image.height}
          alt={previews[0].imageAlt}
          loading="eager"
        />
        <span class="showcase-category" data-showcase-category>{previews[0].category}</span>
        <span class="showcase-number" data-showcase-number aria-live="polite">
          01 / {String(previews.length).padStart(2, "0")}
        </span>
      </div>
      <div class="showcase-copy">
        <div>
          <p class="showcase-kicker">Meet the team</p>
          <h2 data-showcase-title aria-live="polite">{previews[0].title}</h2>
        </div>
        <p data-showcase-description aria-live="polite">{previews[0].description}</p>
      </div>
      <div class="showcase-picker" role="group" aria-label="Choose a team portrait">
        {previews.map((preview, index) => (
          <button
            type="button"
            data-showcase-option
            data-image={preview.image.src}
            data-image-alt={preview.imageAlt}
            data-image-fit={preview.imageFit}
            data-category={preview.category}
            data-title={preview.title}
            data-description={preview.description}
            aria-label={preview.title}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {preview.label}
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .page-shell {
    margin-inline: auto;
    max-width: 1440px;
    padding-inline: clamp(20px, 5vw, 68px);
  }

  .hero-section {
    align-items: center;
    background:
      radial-gradient(ellipse at 82% 18%, rgba(201, 170, 127, 0.22), transparent 34%),
      linear-gradient(125deg, #f8f4ec 0%, #f1e9db 100%);
    display: grid;
    gap: clamp(36px, 7vw, 100px);
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    margin-inline: 0;
    max-width: none;
    min-height: min(720px, calc(100vh - 72px));
    padding-block: clamp(64px, 9vw, 120px);
    position: relative;
  }

  .hero-copy,
  .hero-visual {
    position: relative;
    z-index: 1;
  }

  .hero-visual {
    min-width: 0;
  }

  .hero-copy {
    max-width: 680px;
    min-width: 0;
  }

  .eyebrow {
    align-items: center;
    color: #756958;
    display: flex;
    font-size: 0.7rem;
    font-weight: 700;
    gap: 10px;
    letter-spacing: 0.14em;
    margin: 0 0 26px;
    text-transform: uppercase;
  }

  .eyebrow-mark {
    background: #c5a77f;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(197, 167, 127, 0.18);
    height: 7px;
    width: 7px;
  }

  .hero-copy h1 {
    color: #3a3028;
    font-size: clamp(3.2rem, 6.8vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.94;
    margin: 0;
  }

  .hero-copy h1 em {
    color: #8d6a45;
    font-style: normal;
  }

  .hero-lede {
    color: #756958;
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.8;
    margin: 30px 0 0;
    max-width: 590px;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 36px;
  }

  .button,
  .text-link {
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .button {
    align-items: center;
    background: #3a3028;
    border: 1px solid #3a3028;
    border-radius: 999px;
    box-shadow: 0 8px 18px rgba(58, 48, 40, 0.12);
    color: #fffdf7;
    display: inline-flex;
    gap: 16px;
    min-height: 52px;
    padding: 0 24px;
    transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .button:hover {
    background: #6d5139;
    box-shadow: 0 12px 24px rgba(58, 48, 40, 0.18);
    transform: translateY(-2px);
  }

  .button span,
  .text-link span {
    transition: transform 180ms ease;
  }

  .button:hover span,
  .text-link:hover span {
    transform: translateX(4px);
  }

  .text-link {
    color: #3a3028;
    text-underline-offset: 5px;
    transition: color 180ms ease;
  }

  .text-link:hover {
    color: #8d6a45;
  }

  .hero-replay {
    align-items: center;
    background: transparent;
    border: 0;
    color: #756958;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    gap: 8px;
    padding: 8px 0;
    transition: color 180ms ease;
  }

  .hero-replay svg {
    height: 16px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    transition: transform 220ms ease;
    width: 16px;
  }

  .hero-replay:hover {
    color: #8d6a45;
  }

  .hero-replay:hover svg {
    transform: rotate(-35deg);
  }

  .hero-replay:focus-visible {
    outline: 2px solid #a78d68;
    outline-offset: 4px;
  }

  .hero-replay:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .hero-code {
    background: linear-gradient(145deg, #393027, #211d19);
    border: 1px solid rgba(255, 253, 247, 0.16);
    border-radius: 22px;
    box-shadow: 0 32px 80px rgba(58, 48, 40, 0.22);
    color: #f5efe4;
    min-width: 0;
    padding: 18px;
    transform: rotate(0.5deg);
    transition: box-shadow 240ms ease, transform 240ms ease;
  }

  .hero-code:hover {
    box-shadow: 0 38px 90px rgba(58, 48, 40, 0.28);
    transform: rotate(0deg) translateY(-3px);
  }

  .showcase-image-wrap {
    aspect-ratio: 1.15;
    background: #f5f0e6;
    border: 1px solid rgba(255, 253, 247, 0.16);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
  }

  .showcase-image {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center 24%;
    transition: filter 180ms ease, transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
  }

  .showcase-image.image-contain {
    object-fit: contain;
  }

  .showcase-image-wrap::after {
    background: linear-gradient(180deg, rgba(20, 18, 15, 0.24), transparent 35%, transparent 65%, rgba(20, 18, 15, 0.38));
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .showcase-category,
  .showcase-number {
    color: #fffdf7;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    position: absolute;
    text-transform: uppercase;
    z-index: 1;
  }

  .showcase-category {
    background: rgba(36, 31, 26, 0.72);
    border: 1px solid rgba(255, 253, 247, 0.18);
    border-radius: 999px;
    left: 14px;
    padding: 8px 11px;
    top: 14px;
  }

  .showcase-number {
    bottom: 14px;
    right: 16px;
  }

  .showcase-copy {
    align-items: end;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 20px 2px 18px;
  }

  .showcase-kicker {
    color: #d3b58a;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .showcase-copy h2 {
    color: #fffdf7;
    font-size: clamp(1.05rem, 1.8vw, 1.4rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin: 0;
  }

  .showcase-copy > p {
    color: #c6baa6;
    font-size: 0.75rem;
    line-height: 1.6;
    margin: 0;
    max-width: 190px;
  }

  .showcase-picker {
    background: rgba(14, 13, 11, 0.34);
    border: 1px solid rgba(255, 253, 247, 0.12);
    border-radius: 12px;
    display: grid;
    gap: 6px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 5px;
  }

  .showcase-picker button {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #c6baa6;
    cursor: pointer;
    font: inherit;
    font-size: clamp(0.58rem, 0.8vw, 0.7rem);
    font-weight: 600;
    min-height: 38px;
    padding-inline: 2px;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .showcase-picker button:hover,
  .showcase-picker button[aria-pressed="true"] {
    background: #d3b58a;
    border-color: #d3b58a;
    color: #241f1a;
  }

  :global(:root[data-theme="dark"]) .hero-section {
    background:
      radial-gradient(ellipse at 82% 18%, rgba(211, 181, 138, 0.12), transparent 34%),
      linear-gradient(125deg, #241f1a 0%, #30271f 100%);
  }

  :global(:root[data-theme="dark"]) .hero-copy h1,
  :global(:root[data-theme="dark"]) .text-link {
    color: #f5efe4;
  }

  :global(:root[data-theme="dark"]) .hero-copy h1 em {
    color: #d3b58a;
  }

  :global(:root[data-theme="dark"]) .hero-replay {
    color: #c6baa6;
  }

  :global(:root[data-theme="dark"]) .hero-replay:hover {
    color: #d3b58a;
  }

  :global(:root[data-theme="dark"]) .button {
    background: #d3b58a;
    border-color: #d3b58a;
    color: #241f1a;
  }

  :global(:root[data-theme="dark"]) .button:hover {
    background: transparent;
    color: #f5efe4;
  }

  @media (max-width: 900px) {
    .hero-section {
      gap: 44px;
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
    }

    .hero-code {
      max-width: 620px;
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .hero-section {
      padding-block: 58px 70px;
    }

    .hero-copy h1 {
      font-size: clamp(3rem, 14vw, 4.7rem);
    }

    .hero-code {
      padding: 12px;
      transform: none;
    }

    .showcase-copy {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .showcase-copy > p {
      max-width: none;
    }

    .showcase-picker button {
      font-size: 0.6rem;
      min-height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-code,
    .button,
    .button span,
    .text-link span,
    .hero-replay,
    .hero-replay svg,
    .showcase-image,
    .showcase-picker button {
      transition: none;
    }

    .hero-code:hover,
    .button:hover,
    .button:hover span,
    .text-link:hover span,
    .hero-replay:hover svg,
    .showcase-image:hover {
      transform: none;
    }
  }

</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const clearAnimatedProps = "opacity,visibility,transform,translate,rotate,scale";
  const hero = document.querySelector(".hero-section");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const replayButton = hero?.querySelector<HTMLButtonElement>("[data-replay-intro]");
  let replayIntro = () => {};

  if (replayButton) {
    const updateReplayButton = () => {
      replayButton.disabled = prefersReducedMotion.matches;
      replayButton.title = prefersReducedMotion.matches
        ? "Animations are disabled by your motion preference"
        : "Replay the hero introduction";
    };

    updateReplayButton();
    prefersReducedMotion.addEventListener("change", updateReplayButton);
    replayButton.addEventListener("click", () => replayIntro());
  }

  if (hero) {
    const eyebrow = hero.querySelector<HTMLElement>(".eyebrow");
    const title = hero.querySelector<HTMLElement>("h1");
    const lede = hero.querySelector<HTMLElement>(".hero-lede");
    const actions = hero.querySelectorAll<HTMLAnchorElement>(".hero-actions > a");
    const codePanel = hero.querySelector<HTMLElement>(".hero-code");
    const heroCopy = hero.querySelector<HTMLElement>(".hero-copy");
    const heroVisual = hero.querySelector<HTMLElement>(".hero-visual");

    if (eyebrow && title && lede && codePanel && heroCopy && heroVisual) {
      const introTargets = [eyebrow, title, lede, ...actions, codePanel];
      let introTimeline: gsap.core.Timeline | null = null;
      let scrollTimeline: gsap.core.Timeline | null = null;
      const sectionTriggers: ScrollTrigger[] = [];
      const sectionTimelines: gsap.core.Timeline[] = [];
      const sectionRevealTargets: HTMLElement[] = [];
      const animatedSections = Array.from(
        document.querySelectorAll<HTMLElement>("#process, #about, #projects, #contact")
      );

      const motionContext = gsap.matchMedia();
      motionContext.add("(prefers-reduced-motion: no-preference)", () => {
        introTimeline = gsap
          .timeline({
            defaults: { ease: "power2.out" },
            onComplete: () =>
              gsap.set(introTargets, {
                clearProps: clearAnimatedProps,
              }),
          })
          .from(eyebrow, { autoAlpha: 0, y: 10, duration: 0.42 })
          .from(title, { autoAlpha: 0, y: 18, duration: 0.64 }, "-=0.18")
          .from(lede, { autoAlpha: 0, y: 12, duration: 0.5 }, "-=0.34")
          .from(actions, { autoAlpha: 0, y: 8, duration: 0.42, stagger: 0.08 }, "-=0.28")
          .from(codePanel, { autoAlpha: 0, y: 16, duration: 0.62 }, "-=0.3");

        scrollTimeline = gsap
          .timeline({
            scrollTrigger: {
              trigger: hero,
              start: "top top",
              end: "bottom top",
              scrub: 0.6,
              invalidateOnRefresh: true,
            },
          })
          .to(heroCopy, { y: -18, ease: "none" }, 0)
          .to(heroVisual, { y: 12, ease: "none" }, 0);

        const animateSection = (section: HTMLElement) => {
          const heading = section.querySelector<HTMLElement>(".section-heading");
          const content = Array.from(
            section.querySelectorAll<HTMLElement>(
              ".content-card, .project-filters, .project-count, .contact-form, .contact-quick-links"
            )
          ).filter((element) => !element.closest("[hidden]"));
          const targets = [...(heading ? [heading] : []), ...content];

          if (!targets.length) return;

          section.classList.add("gsap-section-animating");
          sectionRevealTargets.push(...targets);

          const timeline = gsap.timeline({
            defaults: { ease: "power2.out" },
            onComplete: () => {
              gsap.set(targets, {
                clearProps: clearAnimatedProps,
              });
              section.classList.remove("gsap-section-animating");
            },
          });

          if (heading) {
            timeline.fromTo(
              heading,
              { autoAlpha: 0, y: 14 },
              { autoAlpha: 1, y: 0, duration: 0.46 }
            );
          }

          if (content.length) {
            timeline.fromTo(
              content,
              { autoAlpha: 0, y: 12 },
              { autoAlpha: 1, y: 0, duration: 0.4, stagger: 0.06 },
              heading ? "-=0.2" : 0
            );
          }

          sectionTimelines.push(timeline);
        };

        animatedSections.forEach((section) => {
          sectionTriggers.push(
            ScrollTrigger.create({
              trigger: section,
              start: "top 78%",
              once: true,
              onEnter: () => animateSection(section),
            })
          );
        });

        replayIntro = () => introTimeline?.restart();

        return () => {
          replayIntro = () => {};
          introTimeline?.kill();
          scrollTimeline?.scrollTrigger?.kill();
          scrollTimeline?.kill();
          sectionTriggers.forEach((trigger) => trigger.kill());
          sectionTimelines.forEach((timeline) => timeline.kill());
          animatedSections.forEach((section) => {
            section.classList.remove("gsap-section-animating");
          });
          gsap.set([...introTargets, heroCopy, heroVisual], {
            clearProps: clearAnimatedProps,
          });
          gsap.set(sectionRevealTargets, {
            clearProps: clearAnimatedProps,
          });
          introTimeline = null;
          scrollTimeline = null;
        };
      });
    }
  }

  const showcaseImage = hero?.querySelector<HTMLImageElement>("[data-showcase-image]");
  const showcaseCategory = hero?.querySelector<HTMLElement>("[data-showcase-category]");
  const showcaseTitle = hero?.querySelector<HTMLElement>("[data-showcase-title]");
  const showcaseDescription = hero?.querySelector<HTMLElement>("[data-showcase-description]");
  const showcaseNumber = hero?.querySelector<HTMLElement>("[data-showcase-number]");
  const showcaseOptions = hero?.querySelectorAll<HTMLButtonElement>("[data-showcase-option]");
  const showcaseElements = [
    showcaseImage,
    showcaseCategory,
    showcaseTitle,
    showcaseDescription,
  ].filter((element): element is HTMLElement => element !== null);
  let showcaseTransition: gsap.core.Timeline | null = null;

  showcaseOptions?.forEach((option, index) => {
    option.addEventListener("click", () => {
      if (option.getAttribute("aria-pressed") === "true") return;

      const { image, imageAlt, imageFit, category, title, description } = option.dataset;
      if (!image || !imageAlt || !category || !title || !description || !showcaseImage) return;

      const updatePreview = () => {
        showcaseImage.src = image;
        showcaseImage.alt = imageAlt;
        showcaseImage.classList.toggle("image-contain", imageFit === "contain");
        if (showcaseCategory) showcaseCategory.textContent = category;
        if (showcaseTitle) showcaseTitle.textContent = title;
        if (showcaseDescription) showcaseDescription.textContent = description;
        if (showcaseNumber) {
          showcaseNumber.textContent = `${String(index + 1).padStart(2, "0")} / ${String(showcaseOptions.length).padStart(2, "0")}`;
        }
      };

      showcaseOptions.forEach((item) => {
        item.setAttribute("aria-pressed", String(item === option));
      });

      if (prefersReducedMotion.matches) {
        showcaseTransition?.kill();
        gsap.set(showcaseElements, { clearProps: "opacity,visibility,transform" });
        updatePreview();
        return;
      }

      showcaseTransition?.kill();
      showcaseTransition = gsap
        .timeline({
          defaults: { ease: "power2.out" },
          onComplete: () => {
            gsap.set(showcaseElements, {
              clearProps: "opacity,visibility,transform",
            });
            showcaseTransition = null;
          },
        })
        .to(showcaseElements, { autoAlpha: 0, duration: 0.14, stagger: 0.025 })
        .call(updatePreview)
        .to(showcaseElements, { autoAlpha: 1, duration: 0.22, stagger: 0.025 });
    });
  });
</script>
