---
import Card from "../Card.astro";

const nonTechnicalServices = [
  {
    title: "Communication",
    icon: "chat",
    description:
      "Understanding client ideas and sharing clear feedback while planning every project.",
  },
  {
    title: "Photo Editing",
    icon: "image",
    description:
      "Enhancing and retouching photos by improving color, lighting, clarity, and presentation.",
  },
  {
    title: "Layouts & Design",
    icon: "layout",
    description:
      "Creating thoughtful photo layouts and visual designs that match the style of each project.",
  },
];

const programmingServices = [
  {
    title: "Web Development",
    icon: "code",
    description:
      "Building responsive websites and digital experiences using HTML, CSS, and JavaScript.",
  },
  {
    title: "Interactive Features",
    icon: "sparkles",
    description:
      "Developing galleries, animations, filters, user controls, and practical digital interactions.",
  },
  {
    title: "Custom Programming",
    icon: "database",
    description:
      "Turning edited photos and creative layouts into complete, engaging web-based experiences.",
  },
];
---

<section class="services-page" id="services">
    <section class="skills-section" aria-labelledby="non-technical-title">
      <header class="section-heading">
        <p>What we offer</p>
        <h1 id="non-technical-title">Non-Technical Skills</h1>
        <span>Creative skills that help us plan and improve every project.</span>
      </header>

      <div class="skill-grid">
        {nonTechnicalServices.map((service) => (
          <Card title={service.title} desc={service.description} icon={service.icon} />
        ))}
      </div>
    </section>

    <section class="skills-section programming-section" aria-labelledby="programming-title">
      <header class="section-heading">
        <p>What we build</p>
        <h1 id="programming-title">Programming Skills</h1>
        <span>Our technical skills bring creative ideas and edited photos to the web.</span>
      </header>

      <div class="skill-grid">
        {programmingServices.map((service) => (
          <Card title={service.title} desc={service.description} icon={service.icon} />
        ))}
      </div>
    </section>
</section>

<style>
  .services-page {
    background: #fffdf7;
    overflow: hidden;
  }

  .skills-section {
    margin: 0 auto;
    max-width: 1380px;
    padding: 96px clamp(24px, 7vw, 96px);
  }

  .programming-section {
    background: transparent;
    isolation: isolate;
    position: relative;
  }

  .programming-section::before {
    background: linear-gradient(135deg, #f5f0e6, #eee4d3);
    border-top: 1px solid #d8ccb8;
    content: "";
    inset: 0 auto 0 50%;
    position: absolute;
    transform: translateX(-50%);
    width: 100vw;
    z-index: -1;
  }

  .section-heading {
    color: #3a3028;
    margin: 0 auto 46px;
    max-width: 720px;
    text-align: center;
  }

  .section-heading p {
    background: #f1e6ce;
    border-radius: 999px;
    color: #8d6a45;
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin: 0 0 15px;
    padding: 8px 12px;
    text-transform: uppercase;
  }

  .section-heading h1 {
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.02;
    margin: 0 0 14px;
  }

  .section-heading span {
    color: #756958;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .skill-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 800px) {
    .skills-section {
      padding-block: 72px;
    }

    .skill-grid {
      grid-template-columns: 1fr;
    }

    .skill-card {
      min-height: 160px;
    }
  }
</style>
