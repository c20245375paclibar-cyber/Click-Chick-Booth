---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | Click Chick Booth"
  description="About the creative and programming work behind Click Chick Booth."
>
  <main class="about-page">
    <section class="about-section" aria-labelledby="about-title">
      <header class="section-heading">
        <p>Get to know us</p>
        <h1 id="about-title">About Click Chick Booth</h1>
        <span>Creative design and programming work for memorable digital experiences.</span>
      </header>

      <div class="about-grid">
        <article class="about-card">
          <h2>Our creative skills</h2>
          <p>
            We edit and enhance photos, improve visual details, and create layouts
            that present each project clearly and attractively.
          </p>
        </article>
        <article class="about-card">
          <h2>Our approach</h2>
          <p>
            We combine communication, design, and technical thinking to understand
            ideas and turn them into polished results.
          </p>
        </article>
        <article class="about-card">
          <h2>Our programming skills</h2>
          <p>
            We use HTML, CSS, JavaScript, and interactive features to bring our
            edited photos and visual layouts to life on the web.
          </p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-page {
    background: #f5f0e6;
    min-height: calc(100vh - 72px);
  }

  .about-section {
    margin: 0 auto;
    max-width: 1380px;
    padding: 82px clamp(24px, 7vw, 96px) 96px;
  }

  .section-heading {
    color: #3a3028;
    margin-bottom: 42px;
    text-align: center;
  }

  .section-heading p {
    color: #756958;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .section-heading h1 {
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    letter-spacing: -0.04em;
    margin: 0 0 12px;
  }

  .section-heading span {
    color: #756958;
    font-size: 0.88rem;
  }

  .about-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .about-card {
    background: #fffdf7;
    border: 1px solid #d8ccb8;
    border-radius: 0;
    min-height: 210px;
    padding: 38px 32px;
  }

  .about-card h2 {
    color: #3a3028;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    margin: 0 0 16px;
  }

  .about-card p {
    color: #756958;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 800px) {
    .about-section {
      padding-block: 64px;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
