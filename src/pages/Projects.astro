---
import BaseLayout from "../layouts/BaseLayout.astro";
import photoEditing from "./images/photo-editing.jpg";
import creativeLayout from "./images/creative-layout.jpg";
import webDevelopment from "./images/web-development.jpg";

const projects = [
  {
    title: "Photo Editing",
    description:
      "Retouched and enhanced photos with improved color, lighting, detail, and visual consistency.",
    image: photoEditing,
    imageAlt: "Camera and lenses in a black-and-white photo",
  },
  {
    title: "Custom Layouts",
    description:
      "Designed polished photo layouts and compositions for digital presentation and creative projects.",
    image: creativeLayout,
    imageAlt: "Designer drawing on a digital tablet",
  },
  {
    title: "Interactive Websites",
    description:
      "Built responsive web experiences using HTML, CSS, JavaScript, and custom interactive features.",
    image: webDevelopment,
    imageAlt: "Laptop displaying code on a developer's desk",
  },
];
---

<BaseLayout
  title="Projects | Click Chick Booth"
  description="Creative design, photo editing, layouts, and programming projects."
>
  <main class="projects-page">
    <section class="projects-section" aria-labelledby="projects-title">
      <header class="section-heading">
        <p>Our work</p>
        <h1 id="projects-title">Our Projects</h1>
        <span>Creative design connected with practical programming skills.</span>
      </header>

      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
          <div class="project-image-wrap">
            <img
              class="project-image"
              src={project.image.src}
              width={project.image.width}
              height={project.image.height}
              alt={project.imageAlt}
              loading="lazy"
            />
            <span class="project-image-overlay" aria-hidden="true"></span>
          </div>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .projects-page {
    background: linear-gradient(180deg, #f8f4ec, #f2eadc);
    min-height: calc(100vh - 72px);
  }

  .projects-section {
    margin: 0 auto;
    max-width: 1380px;
    padding: 96px clamp(24px, 7vw, 96px) 110px;
  }

  .section-heading {
    color: #3a3028;
    margin: 0 auto 50px;
    max-width: 720px;
    text-align: center;
  }

  .section-heading p {
    background: #f1e6ce;
    border-radius: 999px;
    color: #8d6a45;
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin: 0 0 15px;
    padding: 8px 12px;
    text-transform: uppercase;
  }

  .section-heading h1 {
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.02;
    margin: 0 0 14px;
  }

  .section-heading span {
    color: #756958;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .project-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-card {
    background: #fffdf7;
    border: 1px solid #d8ccb8;
    border-radius: 16px;
    box-shadow: 0 10px 28px rgba(58, 48, 40, 0.055);
    min-height: 330px;
    overflow: hidden;
    padding: 0 28px 30px;
    transition:
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .project-card:hover {
    box-shadow: 0 18px 36px rgba(58, 48, 40, 0.12);
    transform: translateY(-5px);
  }

  .project-image-wrap {
    display: block;
    height: 220px;
    margin: 0 -28px 26px;
    overflow: hidden;
    position: relative;
    width: calc(100% + 56px);
  }

  .project-image {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
  }

  .project-image-overlay {
    background: rgba(36, 31, 26, 0.22);
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transition: opacity 240ms ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.07);
  }

  .project-card:hover .project-image-overlay {
    opacity: 1;
  }

  .project-card h2 {
    color: #3a3028;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }

  .project-card p {
    color: #756958;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 800px) {
    .projects-section {
      padding-block: 72px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(:root[data-theme="dark"]) .projects-page {
    background: #241f1a;
  }

  :global(:root[data-theme="dark"]) .project-card {
    background: #2c261f;
    border-color: #594f43;
  }

  :global(:root[data-theme="dark"]) .project-card h2 {
    color: #f5efe4;
  }

  :global(:root[data-theme="dark"]) .project-card p {
    color: #c6baa6;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-image,
    .project-image-overlay {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover .project-image {
      transform: none;
    }
  }
</style>
