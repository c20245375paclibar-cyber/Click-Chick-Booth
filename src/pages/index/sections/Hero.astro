---
---

<section class="hero-section page-shell" id="hero">
  <div class="hero-copy">
    <p class="eyebrow"><span class="eyebrow-mark"></span> Creative editing & web development</p>
    <h1>Design your ideas.<br /><em>Build your experience.</em></h1>
    <p class="hero-lede">
      Click Chick Booth combines photo editing and visual layouts with programming skills to create polished, interactive digital projects.
    </p>
    <div class="hero-actions">
      <a class="button" href="/#services">Explore services <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/#process">See our process <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="hero-code" aria-label="Example project code">
    <div class="code-window">
      <div class="code-window-bar">
        <span></span><span></span><span></span>
        <small>creative-project.js</small>
      </div>
      <pre><code><span class="code-keyword">const</span> idea = <span class="code-string">"creative"</span>;

<span class="code-keyword">const</span> photo = enhance(image);
<span class="code-keyword">const</span> layout = design(photo);

<span class="code-keyword">function</span> <span class="code-function">buildExperience</span>() {
  <span class="code-keyword">return</span> develop(layout);
}</code></pre>
    </div>
    <p class="code-caption">Design meets development.</p>
  </div>
</section>

<style>
  .page-shell {
    margin-inline: auto;
    max-width: 1440px;
    padding-inline: clamp(20px, 5vw, 68px);
  }

  .hero-section {
    align-items: center;
    background: #f5f0e6;
    display: grid;
    gap: clamp(36px, 7vw, 100px);
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    min-height: min(720px, calc(100vh - 72px));
    padding-block: clamp(64px, 9vw, 120px);
  }

  .hero-copy {
    max-width: 680px;
  }

  .eyebrow {
    align-items: center;
    color: #756958;
    display: flex;
    font-size: 0.7rem;
    font-weight: 700;
    gap: 10px;
    letter-spacing: 0.14em;
    margin: 0 0 24px;
    text-transform: uppercase;
  }

  .eyebrow-mark {
    background: #c5a77f;
    border-radius: 50%;
    height: 8px;
    width: 8px;
  }

  .hero-copy h1 {
    color: #3a3028;
    font-size: clamp(3rem, 6.5vw, 6.2rem);
    letter-spacing: -0.065em;
    line-height: 0.98;
    margin: 0;
  }

  .hero-copy h1 em {
    color: #a78d68;
    font-style: normal;
  }

  .hero-lede {
    color: #756958;
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.75;
    margin: 26px 0 0;
    max-width: 590px;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 32px;
  }

  .button,
  .text-link {
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .button {
    align-items: center;
    background: #c5a77f;
    border: 1px solid #c5a77f;
    border-radius: 999px;
    color: #3a3028;
    display: inline-flex;
    gap: 16px;
    min-height: 48px;
    padding: 0 22px;
  }

  .text-link {
    color: #3a3028;
  }

  .hero-code {
    background: #2c261f;
    box-shadow: 0 28px 70px rgba(58, 48, 40, 0.17);
    color: #f5efe4;
    padding: 16px;
  }

  .code-window {
    background: #241f1a;
    min-height: 300px;
    padding: 0 24px 24px;
  }

  .code-window-bar {
    align-items: center;
    border-bottom: 1px solid #594f43;
    display: flex;
    gap: 7px;
    height: 48px;
    margin-bottom: 25px;
  }

  .code-window-bar > span {
    background: #c5a77f;
    border-radius: 50%;
    height: 7px;
    opacity: 0.8;
    width: 7px;
  }

  .code-window-bar small {
    color: #c6baa6;
    font-size: 0.68rem;
    margin-left: auto;
  }

  .code-window pre {
    color: #e5d8c3;
    font: 0.82rem/1.9 Consolas, "Courier New", monospace;
    margin: 0;
    overflow-x: auto;
  }

  .code-keyword {
    color: #c5a77f;
  }

  .code-string {
    color: #d5a887;
  }

  .code-function {
    color: #d9c6a5;
  }

  .code-caption {
    color: #c6baa6;
    font-size: 0.72rem;
    margin: 14px 0 0;
    text-align: right;
  }

  :global(:root[data-theme="dark"]) .hero-section {
    background: #241f1a;
  }

  :global(:root[data-theme="dark"]) .hero-copy h1,
  :global(:root[data-theme="dark"]) .text-link {
    color: #f5efe4;
  }

  @media (max-width: 900px) {
    .hero-section {
      gap: 44px;
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-code {
      max-width: 620px;
      width: 100%;
    }
  }

</style>

<script>
  import { gsap } from "gsap";

  const hero = document.querySelector(".hero-section");

  if (hero && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const eyebrow = hero.querySelector(".eyebrow");
    const title = hero.querySelector("h1");
    const lede = hero.querySelector(".hero-lede");
    const actions = hero.querySelectorAll(".hero-actions > *");
    const codePanel = hero.querySelector(".hero-code");

    gsap
      .timeline({ defaults: { ease: "power3.out" } })
      .from(eyebrow, { autoAlpha: 0, y: 16, duration: 0.5 })
      .from(title, { autoAlpha: 0, y: 28, duration: 0.75 }, "-=0.22")
      .from(lede, { autoAlpha: 0, y: 18, duration: 0.6 }, "-=0.38")
      .from(actions, { autoAlpha: 0, y: 14, duration: 0.5, stagger: 0.12 }, "-=0.3")
      .from(codePanel, { autoAlpha: 0, x: 30, scale: 0.97, duration: 0.75 }, "-=0.6");
  }
</script>
