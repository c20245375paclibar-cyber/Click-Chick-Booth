---
import Card from "../../../components/Card.astro";

const steps = [
  {
    number: "01",
    title: "Understand",
    description:
      "We begin by learning about your idea, your goals, and the creative or technical work you need.",
  },
  {
    number: "02",
    title: "Plan & Design",
    description:
      "We organize the project and create layouts, visual designs, or photo edits that match your vision.",
  },
  {
    number: "03",
    title: "Build & Develop",
    description:
      "We use HTML, CSS, JavaScript, and our programming skills to turn the approved design into a working experience.",
  },
  {
    number: "04",
    title: "Review & Refine",
    description:
      "We check the finished result, make improvements, and ensure the design and code work clearly across devices.",
  },
];
---

<section class="process-page process-section" id="process" aria-labelledby="process-title">
      <header class="section-heading">
        <p>How we work</p>
        <h1 id="process-title">Our Process</h1>
        <span>A clear four-step process from the first idea to the finished project.</span>
      </header>

      <div class="process-grid">
        {steps.map((step) => (
          <Card eyebrow={step.number} title={step.title} desc={step.description} />
        ))}
      </div>
</section>

<style>
  .process-page {
    background: #f5f0e6;
    min-height: calc(100vh - 72px);
    overflow: hidden;
  }

  .process-section {
    margin: 0 auto;
    max-width: 1380px;
    min-height: 520px;
    padding: 82px clamp(24px, 7vw, 96px) 96px;
  }

  .section-heading {
    color: #3a3028;
    margin-bottom: 42px;
    text-align: center;
  }

  .section-heading p {
    color: #756958;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .section-heading h1 {
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0 0 12px;
  }

  .section-heading span {
    color: #756958;
    font-size: 0.88rem;
  }

  .process-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .process-section {
      min-height: auto;
      padding-block: 64px;
    }

    .process-grid {
      grid-template-columns: 1fr;
    }

  }
</style>
