---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Click Chick Booth"
  description="Contact Click Chick Booth about creative and programming projects."
>
  <main class="contact-page">
    <section class="contact-section" aria-labelledby="contact-title">
      <header class="section-heading">
        <p>Get in touch</p>
        <h1 id="contact-title">Contact Us</h1>
        <span>Tell us about your project and we'll be in touch.</span>
      </header>

      <form
        class="contact-form"
        action="mailto:clickchickbooth@gmail.com"
        method="post"
        enctype="text/plain"
      >
        <label for="name">Name</label>
        <input id="name" name="Name" type="text" autocomplete="name" />

        <label for="email">Email</label>
        <input id="email" name="Email" type="email" autocomplete="email" />

        <label for="message">Message</label>
        <textarea id="message" name="Message" rows="5"></textarea>

        <button type="submit">Send message</button>
      </form>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    background: #fffdf9;
    min-height: calc(100vh - 72px);
  }

  .contact-section {
    margin: 0 auto;
    max-width: 1380px;
    padding: 82px clamp(24px, 7vw, 96px) 96px;
  }

  .section-heading {
    color: #352119;
    margin-bottom: 34px;
    text-align: center;
  }

  .section-heading p {
    color: #995d3a;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .section-heading h1 {
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    letter-spacing: -0.04em;
    margin: 0 0 12px;
  }

  .section-heading span {
    color: #8b5a40;
    font-size: 0.88rem;
  }

  .contact-form {
    background: #f8f0e3;
    border: 1px solid #ead6bf;
    border-radius: 0;
    margin: 0 auto;
    max-width: 820px;
    padding: 30px 32px 28px;
  }

  .contact-form label {
    color: #805039;
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    margin: 0 0 7px;
  }

  .contact-form input,
  .contact-form textarea {
    background: #fffdf9;
    border: 1px solid #ead6bf;
    border-radius: 0;
    color: #352119;
    font: inherit;
    margin: 0 0 18px;
    outline: none;
    padding: 12px 13px;
    width: 100%;
  }

  .contact-form textarea {
    min-height: 120px;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: #bd8a63;
    box-shadow: 0 0 0 4px rgba(189, 138, 99, 0.18);
  }

  .contact-form button {
    align-items: center;
    background: #3e251d;
    border: 0;
    border-radius: 999px;
    color: #fffaf4;
    display: flex;
    font-size: 0.78rem;
    font-weight: 700;
    height: 42px;
    justify-content: center;
    margin: 2px auto 0;
    min-width: 130px;
    cursor: pointer;
  }

  @media (max-width: 800px) {
    .contact-section {
      padding-block: 64px;
    }

    .contact-form {
      padding: 24px 20px;
    }
  }
</style>
