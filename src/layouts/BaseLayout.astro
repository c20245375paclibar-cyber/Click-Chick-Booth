---
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0e6" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="footer-brand" href="/" aria-label="Click Chick Booth home">
          <span>© Click Chick Booth</span>
        </a>
        <p class="footer-services">Photo editing <span>·</span> Custom layouts <span>·</span> Web development</p>
        <a class="footer-contact" href="mailto:clickchickbooth@gmail.com">Let’s make something great <span aria-hidden="true">↗</span></a>
      </div>
      <div class="footer-bottom">
        <a href="/#projects">Selected projects</a>
      </div>
    </footer>
    <script src="../scripts/animation.js"></script>
  </body>
</html>

<style is:global>
  :root {
    overflow-x: clip;
    scroll-behavior: smooth;
    scroll-padding-top: 88px;
    --footer-background: #fff;
    --footer-foreground: #3a3028;
    --footer-muted: #756958;
    --footer-border: #d8ccb8;
    --footer-outline: #d8ccb8;
    --footer-hover: #f1e6ce;
    --footer-accent: #8d6a45;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    background: #fffdf7;
    color: #3a3028;
    font-family: Inter, "Segoe UI", Arial, Helvetica, sans-serif;
    margin: 0;
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: #d7c5a5;
    color: #241f1a;
  }

  main [id] {
    scroll-margin-top: 88px;
  }

  :root[data-theme="dark"] body {
    background: #241f1a;
    color: #f5efe4;
  }

  :root[data-theme="dark"] {
    --footer-background: #241f1a;
    --footer-foreground: #f5efe4;
    --footer-muted: #c6baa6;
    --footer-border: #40382f;
    --footer-outline: #594f43;
    --footer-hover: #3a3228;
    --footer-accent: #d3b58a;
  }

  :root[data-theme="dark"] h1,
  :root[data-theme="dark"] h2,
  :root[data-theme="dark"] h3,
  :root[data-theme="dark"] p,
  :root[data-theme="dark"] a {
    color: #f5efe4;
  }

  :root[data-theme="dark"] .muted,
  :root[data-theme="dark"] .eyebrow,
  :root[data-theme="dark"] .hero-lede,
  :root[data-theme="dark"] .page-lede,
  :root[data-theme="dark"] .step-number,
  :root[data-theme="dark"] .content-card p {
    color: #c6baa6;
  }

  :root[data-theme="dark"] .button {
    background: #f5efe4;
    border-color: #f5efe4;
    color: #241f1a;
  }

  :root[data-theme="dark"] .button:hover {
    background: transparent;
    color: #f5efe4;
  }

  :root[data-theme="dark"] .contact-form button {
    background: #f5efe4;
    color: #241f1a;
  }

  :root[data-theme="dark"] .site-header {
    background: #241f1a;
    border-bottom-color: #594f43;
  }

  :root[data-theme="dark"] .brand,
  :root[data-theme="dark"] nav a,
  :root[data-theme="dark"] .email-link,
  :root[data-theme="dark"] .theme-toggle,
  :root[data-theme="dark"] .brand-mark {
    color: #f5efe4;
  }

  :root[data-theme="dark"] .theme-toggle {
    border-color: #594f43;
  }

  :root[data-theme="dark"] .theme-toggle:hover {
    background: #3a3228;
  }

  :root[data-theme="dark"] .services-page,
  :root[data-theme="dark"] .process-page,
  :root[data-theme="dark"] .about-page,
  :root[data-theme="dark"] .projects-page,
  :root[data-theme="dark"] .contact-page,
  :root[data-theme="dark"] .portfolio-section,
  :root[data-theme="dark"] .portfolio-section-alt,
  :root[data-theme="dark"] .programming-section {
    background: #241f1a;
  }

  :root[data-theme="dark"] .programming-section,
  :root[data-theme="dark"] .content-card,
  :root[data-theme="dark"] .contact-form,
  :root[data-theme="dark"] .contact-form input,
  :root[data-theme="dark"] .contact-form textarea {
    background: #2c261f;
    border-color: #594f43;
  }

  :root[data-theme="dark"] .section-heading,
  :root[data-theme="dark"] .section-heading h1,
  :root[data-theme="dark"] .content-card h2,
  :root[data-theme="dark"] .contact-form input,
  :root[data-theme="dark"] .contact-form textarea {
    color: #f5efe4;
  }

  :root[data-theme="dark"] .section-heading span,
  :root[data-theme="dark"] .section-heading p,
  :root[data-theme="dark"] .content-card p,
  :root[data-theme="dark"] .contact-form label {
    color: #c6baa6;
  }

  :root[data-theme="dark"] .portfolio-card p {
    color: #c6baa6;
  }

  a:focus-visible {
    outline: 2px solid #3a3028;
    outline-offset: 4px;
  }

  :root[data-theme="dark"] :focus-visible {
    outline-color: #d3b58a;
  }

  .skip-link {
    background: #3a3028;
    border-radius: 999px;
    color: #fffdf7;
    left: 16px;
    padding: 12px 18px;
    position: fixed;
    top: 12px;
    transform: translateY(calc(-100% - 16px));
    transition: transform 180ms ease;
    z-index: 200;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  :root[data-theme="dark"] .skip-link {
    background: #d3b58a;
    color: #241f1a;
  }

  .site-footer {
    background: var(--footer-background);
    color: var(--footer-foreground);
    padding: 38px clamp(24px, 7vw, 96px) 20px;
  }

  .footer-inner,
  .footer-bottom {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-inline: auto;
    max-width: 1248px;
  }

  .footer-inner {
    gap: 24px;
    padding-bottom: 30px;
  }

  .footer-brand {
    align-items: center;
    color: var(--footer-foreground);
    display: inline-flex;
    font-size: 0.88rem;
    font-weight: 700;
    gap: 12px;
    text-decoration: none;
  }

  .footer-brand small {
    color: var(--footer-muted);
    display: block;
    font-size: 0.68rem;
    font-weight: 400;
    margin-top: 4px;
  }

  .footer-services,
  .footer-bottom {
    color: var(--footer-muted);
    font-size: 0.72rem;
  }

  .footer-services span {
    color: var(--footer-accent);
    padding-inline: 5px;
  }

  .footer-contact,
  .footer-bottom a {
    color: var(--footer-foreground);
    text-decoration: none;
  }

  .footer-contact {
    border: 1px solid var(--footer-outline);
    border-radius: 999px;
    font-size: 0.75rem;
    padding: 12px 16px;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .footer-contact:hover {
    background: var(--footer-hover);
    border-color: var(--footer-accent);
  }

  .footer-contact span {
    color: var(--footer-accent);
    margin-left: 8px;
  }

  .footer-bottom {
    border-top: 1px solid var(--footer-border);
    padding-top: 18px;
  }

  .footer-bottom a {
    color: var(--footer-muted);
  }

  .footer-bottom a:hover {
    color: var(--footer-foreground);
  }

  :root[data-theme="dark"] .footer-brand,
  :root[data-theme="dark"] .footer-contact,
  :root[data-theme="dark"] .footer-bottom a {
    color: var(--footer-foreground);
  }

  :root[data-theme="dark"] .footer-brand small,
  :root[data-theme="dark"] .footer-services,
  :root[data-theme="dark"] .footer-bottom {
    color: var(--footer-muted);
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 700ms ease var(--reveal-delay, 0ms),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .gsap-section-animating .content-card,
  .gsap-section-animating .contact-form,
  .gsap-section-animating .project-filters,
  .gsap-section-animating .project-count {
    transition: none !important;
  }

  .content-card,
  .contact-form {
    transition:
      opacity 700ms ease var(--reveal-delay, 0ms),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms),
      border-color 220ms ease,
      box-shadow 220ms ease,
      background 220ms ease;
  }

  .content-card:hover {
    border-color: #c5a77f;
    box-shadow: 0 18px 36px rgba(58, 48, 40, 0.08);
    transform: translateY(-5px);
  }

  nav a,
  .brand,
  .email-link,
  .button,
  .text-link,
  .contact-form button {
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .button:hover,
  .contact-form button:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }

    .reveal {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .footer-bottom {
      gap: 20px;
    }
  }
</style>
